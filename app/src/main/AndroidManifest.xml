<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        One permission, POST_NOTIFICATIONS, and nothing else — not even INTERNET.

        POST_NOTIFICATIONS is for the ongoing notification that shows or closes the pad. It is off
        by default, and Android asks the user for it only when they turn the notification on in the
        app, so a user who never does is never asked for anything. A notification never leaves the
        phone.

        The absence of INTERNET is enforced by the kernel (the UID is left out of the `inet`
        group), not by a promise, and it cannot be acquired later without a new APK the user
        installs. In particular there is no SYSTEM_ALERT_WINDOW: the pad is a
        TYPE_ACCESSIBILITY_OVERLAY window, which an accessibility service may add without it.
        Verify on the built APK rather than trusting this file:
            aapt2 dump permissions app-debug.apk    # the package line and POST_NOTIFICATIONS only
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AscAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            The Quick Settings tile. BIND_QUICK_SETTINGS_TILE is the permission SystemUI must hold
            to bind it, not one this app requests.
        -->
        <service
            android:name=".PadTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The ongoing notification's button. Only its own PendingIntent can reach it. -->
        <receiver
            android:name=".PadNotificationReceiver"
            android:exported="false" />

    </application>

</manifest>
